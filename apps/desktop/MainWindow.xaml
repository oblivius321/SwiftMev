<Window x:Class="SwiftMev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwiftMev Alpha 0.4 | Análise Microscópica e Validação Científica" 
        Height="640" Width="1100" MinHeight="480" MinWidth="800"
        Background="#0B0F17" Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / MenuBar -->
            <RowDefinition Height="*"/>    <!-- Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Bar: Branding, Draggable Header, Project Actions & Window Controls -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" 
                Padding="14,6" MouseLeftButtonDown="TopBar_MouseLeftButtonDown" Cursor="Arrow">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SwiftMev" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                    <Border Background="#0369A1" CornerRadius="4" Margin="10,2,0,2" Padding="6,2">
                        <TextBlock Text="Alpha 0.4" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="— Microscopia de Varredura e Ensaios In Vitro" MaxWidth="260" TextTrimming="CharacterEllipsis" 
                               Foreground="#64748B" FontSize="11" Margin="10,4,0,0"/>
                </StackPanel>

                <!-- Window & Project Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Abrir Imagem" Click="ChooseImage_Click" Padding="10,5" Margin="3,0" 
                            Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="11" Cursor="Hand"/>
                    <Button Content="💾 Salvar Projeto" Click="SaveProject_Click" Padding="10,5" Margin="3,0" 
                            Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="11" Cursor="Hand"/>
                    <Button Content="📁 Abrir Projeto" Click="OpenProject_Click" Padding="10,5" Margin="3,0" 
                            Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="11" Cursor="Hand"/>
                    <Button Content="📊 Exportar Relatório" Click="ExportReport_Click" Padding="10,5" Margin="3,0" 
                            Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>

                    <!-- Separador -->
                    <Border Width="1" Height="20" Background="#334155" Margin="8,0"/>

                    <!-- Botões da Janela: Minimizar, Maximizar, Fechar (X) -->
                    <Button Content="—" Click="Minimize_Click" Width="30" Height="26" Margin="2,0"
                            Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11"
                            ToolTip="Minimizar Janela" Cursor="Hand"/>
                    <Button x:Name="BtnMaximize" Content="🗖" Click="Maximize_Click" Width="30" Height="26" Margin="2,0"
                            Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="11"
                            ToolTip="Maximizar / Restaurar" Cursor="Hand"/>
                    <Button Content="✕" Click="Close_Click" Width="34" Height="26" Margin="2,0"
                            Background="#DC2626" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="Bold"
                            ToolTip="Fechar SwiftMev" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace (3 Panes: Tools/Controls, Center Viewer, Right Metrics) -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <!-- Left Pane: Parameters & Pipeline -->
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>   <!-- Center Pane: Interactive Microscopic Viewer -->
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/> <!-- Right Pane: Metrics, Audit & History -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Parâmetros, Calibração e Ferramentas -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Seção 1: Calibração Espacial -->
                        <TextBlock Text="1. CALIBRAÇÃO ESPACIAL" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Escala (μm / pixel):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCalibration" Text="1.0" Padding="6,4" Background="#0B0F17" 
                                             Foreground="#F8FAFC" BorderBrush="#334155" TextChanged="Calibration_TextChanged"/>
                                    <TextBlock Grid.Column="1" Text="μm/px" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#64748B" FontSize="11"/>
                                </Grid>
                                
                                <Button x:Name="BtnRulerCalibrate" Content="📏 Calibrar por Barra de Escala" Click="RulerCalibrate_Click"
                                        Padding="8,6" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" 
                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                <TextBlock x:Name="RulerStatus" Text="Clique para medir a barra na imagem" 
                                           FontSize="10" Foreground="#FBBF24" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Seção 2: Segmentação Automática -->
                        <TextBlock Text="2. SEGMENTAÇÃO AUTOMÁTICA" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Módulo Científico:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbModule" SelectedIndex="0" Padding="6,4" Margin="0,0,0,10"
                                          Background="#0B0F17" Foreground="#0F172A">
                                    <ComboBoxItem Content="🔬 Diâmetro de Fibras (MEV)" Tag="fiber"/>
                                    <ComboBoxItem Content="🧫 Migração Celular (Scratch)" Tag="migration"/>
                                </ComboBox>

                                <TextBlock Text="Algoritmo de Binarização:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbMethod" SelectedIndex="0" Padding="6,4" Margin="0,0,0,10"
                                          Background="#0B0F17" Foreground="#0F172A">
                                    <ComboBoxItem Content="Otsu Global (Padrão Rigoroso)" Tag="otsu"/>
                                    <ComboBoxItem Content="Sauvola Local (Experimental)" Tag="sauvola"/>
                                </ComboBox>

                                <CheckBox x:Name="ChkClahe" Content="CLAHE (Correção de Gradiente)" 
                                          Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkInvert" Content="Inverter Polaridade da Máscara" 
                                          Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,10"/>

                                <Button x:Name="BtnRunAuto" Content="⚡ Processar Imagem" Click="RunAutoSegmentation_Click"
                                        Padding="10,8" Background="#0284C7" Foreground="White" FontWeight="Bold" 
                                        BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Seção 3: Edição Manual de Máscara -->
                        <TextBlock Text="3. EDIÇÃO MANUAL DE MÁSCARA" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Ferramenta de Edição:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton x:Name="ToolPan" Content="🖐 Pan/Zoom" GroupName="Tool" IsChecked="True" 
                                                 Checked="Tool_Checked" Foreground="#E2E8F0" FontSize="11" Margin="0,0,8,4"/>
                                    <RadioButton x:Name="ToolBrush" Content="🖌 Pincel (+)" GroupName="Tool" 
                                                 Checked="Tool_Checked" Foreground="#4ADE80" FontSize="11" Margin="0,0,8,4"/>
                                    <RadioButton x:Name="ToolEraser" Content="🧹 Borracha (-)" GroupName="Tool" 
                                                 Checked="Tool_Checked" Foreground="#F87171" FontSize="11" Margin="0,0,0,4"/>
                                </WrapPanel>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Raio:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblBrushSize" Text="10 px" FontSize="11" Foreground="#F8FAFC" 
                                               DockPanel.Dock="Right" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                                    <Slider x:Name="SliderBrushSize" Minimum="2" Maximum="50" Value="10" 
                                            ValueChanged="SliderBrushSize_ValueChanged" Margin="8,0"/>
                                </DockPanel>

                                <Button Content="↺ Restaurar Máscara Original" Click="RestoreOriginalMask_Click" 
                                        Padding="6,4" Background="#334155" Foreground="#CBD5E1" BorderThickness="0" 
                                        FontSize="10" Margin="0,0,0,8" Cursor="Hand"/>

                                <Button x:Name="BtnRecalculate" Content="📐 Recalcular Métricas da Máscara" Click="RecalculateMetrics_Click"
                                        Padding="8,8" Background="#059669" Foreground="White" FontWeight="Bold" 
                                        FontSize="11" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Box de Alerta Científico -->
                        <Border x:Name="WarningBox" Visibility="Collapsed" Background="#451A03" BorderBrush="#F59E0B" 
                                BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="⚠️ Validação / Alerta Metrológico" FontWeight="Bold" Foreground="#FBBF24" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtWarningMessage" TextWrapping="Wrap" Foreground="#FEF3C7" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER PANE: Visualizador Microscópico com Zoom, Pan e Camadas -->
            <Border Grid.Column="2" Background="#05080E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Viewer Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Canvas Area -->
                    </Grid.RowDefinitions>

                    <!-- Viewer Toolbar -->
                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <!-- View Toggles -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Camadas:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ChkShowOverlay" Content="Contornos" IsChecked="True" 
                                          Checked="LayerVisibility_Changed" Unchecked="LayerVisibility_Changed"
                                          Foreground="#E2E8F0" FontSize="11" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkShowMask" Content="Máscara (Alpha)" IsChecked="True" 
                                          Checked="LayerVisibility_Changed" Unchecked="LayerVisibility_Changed"
                                          Foreground="#E2E8F0" FontSize="11" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkShowScaleBar" Content="Barra de Escala" IsChecked="True" 
                                          Checked="LayerVisibility_Changed" Unchecked="LayerVisibility_Changed"
                                          Foreground="#E2E8F0" FontSize="11" Margin="0,0,16,0"/>

                                <TextBlock Text="Opacidade:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderMaskAlpha" Minimum="0" Maximum="1" Value="0.4" Width="80" 
                                        ValueChanged="SliderMaskAlpha_ValueChanged" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Zoom Tools -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➖" Click="ZoomOut_Click" Padding="6,2" Background="#1E293B" Foreground="White" BorderThickness="0" Margin="2,0"/>
                                <TextBlock x:Name="TxtZoomLevel" Text="100%" Width="46" TextAlignment="Center" 
                                           VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"/>
                                <Button Content="➕" Click="ZoomIn_Click" Padding="6,2" Background="#1E293B" Foreground="White" BorderThickness="0" Margin="2,0"/>
                                <Button Content="Ajustar" Click="ZoomFit_Click" Padding="8,2" Background="#1E293B" Foreground="White" BorderThickness="0" Margin="6,0,0,0" FontSize="11"/>
                                <Button Content="1:1" Click="ZoomReset_Click" Padding="8,2" Background="#1E293B" Foreground="White" BorderThickness="0" Margin="4,0,0,0" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Interactive Microscopic Canvas -->
                    <Border Grid.Row="1" ClipToBounds="True" Background="#030712">
                        <Canvas x:Name="ViewportCanvas" Background="Transparent" 
                                MouseWheel="Viewport_MouseWheel"
                                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                                MouseMove="Viewport_MouseMove"
                                MouseRightButtonDown="Viewport_MouseRightButtonDown"
                                MouseRightButtonUp="Viewport_MouseRightButtonUp"
                                Cursor="Arrow">
                            
                            <!-- Container com Transformações de Zoom e Pan -->
                            <Grid x:Name="ImageContainer" Canvas.Left="0" Canvas.Top="0">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ViewportScale" ScaleX="1.0" ScaleY="1.0"/>
                                        <TranslateTransform x:Name="ViewportTranslate" X="0" Y="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- Camada 0: Imagem Bruta Original (Imutável) -->
                                <Image x:Name="ImgSource" Stretch="None"/>

                                <!-- Camada 1: Máscara Translúcida Editável (WriteableBitmap) -->
                                <Image x:Name="ImgMaskLayer" Stretch="None" Opacity="0.4"/>

                                <!-- Camada 2: Imagem Anotada com Contornos -->
                                <Image x:Name="ImgOverlay" Stretch="None" Visibility="Visible"/>

                                <!-- Camada 3: Régua de Calibração / Desenho Vetorial -->
                                <Line x:Name="RulerLine" Stroke="#FBBF24" StrokeThickness="2" StrokeDashArray="2 2" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Camada de Interface Fixa sobre o Canvas: Barra de Escala Gráfica -->
                            <Border x:Name="ScaleBarOverlay" Canvas.Left="20" Canvas.Bottom="20" 
                                    Background="#99000000" CornerRadius="4" Padding="8,4" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border x:Name="ScaleBarLine" Background="White" Height="4" Width="100" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ScaleBarLabel" Text="50 μm" Foreground="White" FontSize="11" 
                                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Placeholder para quando não há imagem -->
                            <TextBlock x:Name="TxtEmptyPlaceholder" 
                                       Text="Nenhuma imagem carregada.&#x0a;Clique em 'Abrir Imagem' para iniciar a análise." 
                                       Canvas.Left="150" Canvas.Top="200"
                                       Foreground="#475569" FontSize="14" TextAlignment="Center"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANE: Métricas Científicas, Auditoria e Histórico -->
            <Border Grid.Column="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Metrics Cards -->
                        <RowDefinition Height="Auto"/> <!-- Detailed Stats Table -->
                        <RowDefinition Height="*"/>    <!-- Audit Log & Metadata -->
                    </Grid.RowDefinitions>

                    <!-- Metrics Cards -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="RESULTADOS CIENTÍFICOS" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="LblMetric1Title" Text="Diâmetro Mediano" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="ValMetric1" Text="--" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="LblMetric2Title" Text="Desvio Padrão" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="ValMetric2" Text="--" FontSize="17" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Latência Wall" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="ValLatency" Text="-- ms" FontSize="14" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Memória RSS" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="ValMemory" Text="-- MB" FontSize="14" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Resumo Estatístico Expandido -->
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Estatísticas Descritivas:" FontWeight="SemiBold" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtStatsDetail" Text="Aguardando processamento..." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Registro de Auditoria / Parâmetros do Projeto -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Registro de Auditoria e Proveniência:" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" x:Name="TxtAuditLog" Background="#1E293B" Foreground="#94A3B8" IsReadOnly="True" 
                                 FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                 BorderBrush="#334155" Padding="8" Text="Sistema iniciado. Pronto para nova análise."/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Pronto" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text=" | " Foreground="#475569" FontSize="11" Margin="8,0"/>
                    <TextBlock x:Name="StatusCursorPos" Text="X: --, Y: --" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="SwiftMev Alpha 0.4 • Rigor Metrológico • Offline" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
